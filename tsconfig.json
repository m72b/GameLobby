{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "jsx": "react-jsx", "esModuleInterop": true, "skipLibCheck": true, "types": ["node"],
    "resolveJsonModule": true, "noEmit": true, "baseUrl": ".",
    "paths": { "@/*": ["src/renderer/*"], "@shared/*": ["src/shared/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "electron.vite.config.ts"]
}
